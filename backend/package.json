{
  "name": "adaptive-exam-proctoring-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Adaptive AI-Based Online Examination & Proctoring System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "package:lambda": "tar -a -cf lambda-deployment.zip src node_modules lambda.js package.json",
    "deploy:lambda": "node scripts/deploy-lambda.js",
    "setup:aws": "node scripts/setup-aws-resources.js",
    "assign-teacher": "node scripts/assign-teacher-role.js"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1147.0",
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/client-lambda": "^3.1147.0",
    "@aws-sdk/client-rekognition": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/client-sns": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@codegenie/serverless-express": "^5.0.0",
    "aws-jwt-verify": "^5.2.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "keywords": [
    "edtech",
